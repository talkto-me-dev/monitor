# 复制为 .env 并填写真实值（bun 启动时自动从工作目录加载 .env）
# 值建议用单引号包裹，保证 bash source 与 bun 解析行为一致

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=status
DB_PASSWORD=''
DB_NAME=status
# 可选，JSON 格式，例如 '{"rejectUnauthorized":true}'
# DB_SSL=''

# Redis
REDIS_HOST=''
REDIS_PORT=6379
REDIS_USERNAME=''
REDIS_PASSWORD=''

# 告警通道（LARK 与 PUSHPLUS 至少配一个）
# 飞书群机器人 webhook URL
LARK=''
# PushPlus token 与群组编码
PUSHPLUS=''
PUSHPLUS_TOPIC=''

# conf/watch.yml 中 ${VAR} 占位符引用的秘密
SENTINEL_PASSWORD=''
SMTP_PASSWORD=''

# mysql/tidb 探测的数据库密码：占位符名字自由，按实例一库一键，
# 如 watch.yml 的 mysql/tidb-prod 写 ${MYSQL_PASSWORD_TIDB_PROD}，这里就补同名键
# MYSQL_PASSWORD_TIDB_PROD=''
# MYSQL_PASSWORD_XXX=''

# nginx 5xx 统计端点鉴权 token（与 nginx 侧 set $monitor_token 一致，见 nginx/README.md）
NGINX_STAT_TOKEN=''

# http 健康端点探测的 x-token 头（如 k8s 微服务 /healthz，可选）
# HEALTH_TOKEN=''

# 部署目标（deploy.sh 用，ssh 主机别名）
DEPLOY_VPS=''

# 状态页完整 URL（含 token，用作告警卡片页脚链接，可留空）
STATUS_PAGE=''
